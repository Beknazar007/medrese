# Copy to .env and fill in. .env is git-ignored; never commit real values.
# The same file serves `uvicorn` (backend reads ../.env) and `docker compose`.

# --- Database ---------------------------------------------------------------
# For uvicorn on your machine (Postgres from `docker compose up -d db`).
# Docker compose builds its own URL from POSTGRES_* below and ignores this one.
DATABASE_URL=postgresql+psycopg://medrese:medrese@localhost:5432/medrese
POSTGRES_USER=medrese
POSTGRES_PASSWORD=medrese
POSTGRES_DB=medrese
POSTGRES_PORT=5432

# --- Auth -------------------------------------------------------------------
# Local uvicorn accepts this placeholder; the Docker backend refuses to start with it — put a random value there.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated addresses allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- First rector account (python -m app.seed) --------------------------------
SEED_RECTOR_USERNAME=rector
SEED_RECTOR_PASSWORD=change-me
SEED_RECTOR_FULL_NAME="Rector Rector"

# --- Docker compose ports and the API address baked into the frontend build ----
BACKEND_PORT=8000
FRONTEND_PORT=8080
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Telegram channel for how-to videos (videos/tools/publish_telegram.py) ----
# The bot must be an admin of the channel with the right to post.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- ElevenLabs voice-over (videos/tools/make_video.py) -----------------------
# With a key here and a voice_id in videos/tools/voices.json, that language is voiced by
# ElevenLabs (eleven_v3 speaks Kyrgyz); otherwise edge-tts is used.
ELEVENLABS_API_KEY=
